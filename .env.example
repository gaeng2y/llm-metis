# Choose one provider and supply its key. The model credentials remain owned by Codex.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=

JEV_TOOL_MIN_CONFIDENCE=0.85
JEV_EFFORT_MIN_CONFIDENCE=0.85
JEV_TIMEOUT_MS=2000
JEV_TOOL_ROUTING=on
JEV_EFFORT_ROUTING=on
JEV_DIRECT_CALLS=off
JEV_PORT=8791

# Optional: defaults follow readable Codex login metadata.
# UPSTREAM_BASE_URL=https://chatgpt.com/backend-api/codex
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# JEV_MODEL=jev-latest
# JEV_URL=http://127.0.0.1:8799/evaluate
# JEV_STATE_DIR=/absolute/private/state/directory
# JEV_CODEX_BIN=/absolute/path/to/codex
