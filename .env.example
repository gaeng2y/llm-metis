# Legacy JEV_* names remain a fallback only when the corresponding METIS_* name is unset.
# Select openrouter, vercel, or typesafe. Codex owns separate model credentials.
# All three keys may be stored here; only the selected provider's key is used.
# Restart the gateway after changing the selection or credentials.
METIS_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=

METIS_TOOL_MIN_CONFIDENCE=0.85
METIS_EFFORT_MIN_CONFIDENCE=0.85
METIS_TIMEOUT_MS=2000
METIS_TOOL_ROUTING=on
METIS_EFFORT_ROUTING=on
METIS_DIRECT_CALLS=off
METIS_PORT=8791

# Optional: defaults follow readable Codex login metadata.
# UPSTREAM_BASE_URL=https://chatgpt.com/backend-api/codex
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# Overrides must use the selected provider's evaluation API format.
# METIS_MODEL=provider-model-id
# METIS_URL=http://127.0.0.1:8799/evaluate
# Default state is .local/state/llm-metis under your home directory on every OS.
# METIS_STATE_DIR=/absolute/private/state/directory
# Windows example: METIS_STATE_DIR=C:\Users\your-name\.local\state\llm-metis
# Native executable or JavaScript entry point (.js, .mjs, .cjs).
# METIS_CODEX_BIN=/absolute/path/to/codex
# Windows example: METIS_CODEX_BIN=C:\Tools\codex.exe
