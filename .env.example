# Select openrouter (default), vercel, or typesafe. Codex owns separate model credentials.
# All three keys may be stored here; only the selected provider's key is used.
# Restart the gateway after changing the selection or credentials.
JEV_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=

JEV_TOOL_MIN_CONFIDENCE=0.85
JEV_EFFORT_MIN_CONFIDENCE=0.85
JEV_TIMEOUT_MS=2000
JEV_TOOL_ROUTING=on
JEV_EFFORT_ROUTING=on
JEV_DIRECT_CALLS=off
JEV_PORT=8791

# Optional: defaults follow readable Codex login metadata.
# UPSTREAM_BASE_URL=https://chatgpt.com/backend-api/codex
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# Overrides must use the selected provider's evaluation API format.
# JEV_MODEL=provider-model-id
# JEV_URL=http://127.0.0.1:8799/evaluate
# Default state is .local/state/jev-control under your home directory on every OS.
# JEV_STATE_DIR=/absolute/private/state/directory
# Windows example: JEV_STATE_DIR=C:\Users\your-name\.local\state\jev-control
# Native executable or JavaScript entry point (.js, .mjs, .cjs).
# JEV_CODEX_BIN=/absolute/path/to/codex
# Windows example: JEV_CODEX_BIN=C:\Tools\codex.exe
